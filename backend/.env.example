# Backend server qaysi portda ishga tushishi
PORT=4000

# MUHIM: hozircha Next.js ilovasi (../.env dagi DATABASE_URL) bilan BITTA
# Postgres bazasini ishlatamiz — bazada users/salons/services/bookings/blocked_slots
# jadvallari umumiy. Agar backend uchun alohida baza kerak bo'lsa, shu yerga
# o'sha bazaning connection string'ini yozing va src/db/schema.ts ni ham
# shunga mos migratsiya qiling.
DATABASE_URL=postgresql://user:password@localhost:5432/navbat

# Frontend (Next.js) qaysi manzil(lar)dan ishlaydi — CORS shu ro'yxatdagi ISTALGAN
# origin'dan kelgan so'rovga ruxsat beradi (cookie orqali sessiya ishlashi uchun aniq
# origin bo'lishi shart, "*" ishlamaydi). Bir nechta origin bo'lsa vergul bilan ajrating.
FRONTEND_ORIGIN=http://localhost:3000,https://navbat-site.vercel.app

# Telegram bot tokenlari (ixtiyoriy — bo'lmasa /api/bot-b2c va /api/bot-b2b 500 qaytaradi)
BOT_B2C_TOKEN=
BOT_B2B_TOKEN=

NODE_ENV=development
